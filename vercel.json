{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-updates",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/send-updates",
      "schedule": "0 21 * * 4"
    }
  ]
}
